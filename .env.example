# Backend API URL (Production: https://api.foodsaver.voxelle.io.vn)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id

# Mapbox Public Access Token (Bắt buộc để hiển thị Bản đồ món ngon & Định vị)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Cloudinary Public Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=foodsaver
